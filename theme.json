{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "base", "color": "#fafaf8", "name": "Base" },
				{ "slug": "contrast", "color": "#2a2a28", "name": "Contrast" },
				{ "slug": "accent", "color": "#2563eb", "name": "Accent" },
				{ "slug": "muted", "color": "#6b6965", "name": "Muted" },
				{ "slug": "subtle", "color": "#f0efed", "name": "Subtle" },
				{ "slug": "faint", "color": "#9b9790", "name": "Faint" },
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "border", "color": "#e5e4e1", "name": "Border" }
			],
			"defaultPalette": false,
			"defaultGradients": false
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "'Space Mono', monospace",
					"slug": "mono",
					"name": "Space Mono",
					"fontFace": [
						{
							"fontFamily": "Space Mono",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": ["https://fonts.gstatic.com/s/spacemono/v14/i7dPIFZifjKcF5UAWdDRYEF8RQ.woff2"]
						},
						{
							"fontFamily": "Space Mono",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": ["https://fonts.gstatic.com/s/spacemono/v14/i7dMIFZifjKcF5UAWdDRaPpZYFKQHw.woff2"]
						}
					]
				},
				{
					"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
					"slug": "sans",
					"name": "Inter",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "300 600",
							"fontStyle": "normal",
							"src": ["https://fonts.gstatic.com/s/inter/v18/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuLyfAZ9hjA.woff2"]
						}
					]
				}
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1100px"
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--muted)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "17px",
			"lineHeight": "1.75"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(36px, 5vw, 56px)",
					"fontWeight": "300",
					"letterSpacing": "-1.5px",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "clamp(20px, 3vw, 24px)",
					"fontWeight": "400",
					"letterSpacing": "-0.5px",
					"textTransform": "lowercase"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "18px",
					"fontWeight": "700"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/separator": {
				"border": {
					"color": "var(--wp--preset--color--border)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontWeight": "700",
					"fontSize": "18px",
					"letterSpacing": "-0.5px"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--accent)"
							}
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "14px"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--muted)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--accent)"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
